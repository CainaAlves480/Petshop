# Copie este arquivo para .env e ajuste os valores do seu PostgreSQL
PORT=3000

# Opção 1: URL completa (recomendada)
DATABASE_URL=postgresql://postgres:senha@localhost:5432/petshop

# Opção 2: parâmetros individuais (usados se DATABASE_URL não estiver definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=senha
DB_NAME=petshop
